{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend (Express)",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PORT=5001", "node", "server.js"],
      "cwd": "backend",
      "port": 5001,
      "autoPort": false
    },
    {
      "name": "Frontend (Vite + React)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": true
    }
  ]
}
